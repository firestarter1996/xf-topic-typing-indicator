__id__ = "topic_typing"
__name__ = "Topic Typing Indicator"
__description__ = "In forum groups every topic shows its own typing indicator, in the topic tabs, the topic list and the topic itself, even when people type in several topics at once. Made by [firestarter1996](https://github.com/firestarter1996)."
__author__ = "firestarter1996"
__version__ = "1.0.6"

# Why stock only shows typing in one topic per group:
#   MessagesController.updatePrintingStrings walks every group and, inside the
#   loop over that group's topics, puts a NEW empty map for the group on every
#   pass. So when people type in two or more topics of one group at the same
#   time, every topic but the last one loses its "typing" text. Nagram fixed it
#   upstream (NextAlone/Nagram pull 209); Nagram XF 12.10.1 does not have it.
#
# This plugin, for groups only:
#   1. after each stock run, rebuilds the typing text of every topic of any group
#      where people type in two or more topics, with the same wording, emoji and
#      filters as stock (blocked users stay hidden when that option is on);
#   2. posts the result right after stock's own result on the UI thread and asks
#      for a redraw, so the topic header and the topic list read the right text;
#   3. draws the typing dots on every topic tab (top tabs and side tabs) whose
#      topic has someone typing. Stock tabs show no typing at all.
# Private chats and groups with typing in one topic are left exactly as stock.
#
# Speed (1.0.1): the app calls updatePrintingStrings from its network timer, up to
# about 200 times a second while it catches up after a launch. 1.0.0 rebuilt every
# text in Python and posted work to the UI thread on every call, which froze the app
# for seconds after a launch (ANR "No response to onStartJob"). Now a before hook
# compares one hash of the typing list (a single Java call) and skips the rebuild,
# stock's and ours, when nothing changed (a full rebuild still runs at least once a
# second so late loaded names and action changes show). The UI thread gets work only
# when the fixed texts or the topics with typing actually change.
# Background (1.0.5, 11-10-2026): the dots phase realign ran once a second from the UI thread
# for as long as ANY typing dots drawable said it was started, and a drawable stays started
# after its row scrolls away or XF goes to the background. With the bridge bots typing all day
# it ran nonstop: about 7% of a core on XF's main thread with the screen off (simpleperf on the
# 8 Pro). Now it skips dots whose view is off screen, stops while XF is in the
# background (ApplicationLoader.mainInterfacePaused) and starts again when XF comes back. One
# Runnable is made at load and reused, instead of a new one every second.
# Logcat tag: TopicTyping.

import threading
import time

from java import jclass, jint, jarray
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import run_on_ui_thread, dp
from ui.settings import Header, Switch, Divider

LOG_TAG = "TopicTyping"

JLong = jclass("java.lang.Long")
JInteger = jclass("java.lang.Integer")
JObject = jclass("java.lang.Object")
JString = jclass("java.lang.String")
LongSparseArray = jclass("androidx.collection.LongSparseArray")
LocaleController = jclass("org.telegram.messenger.LocaleController")
AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
RString = jclass("org.telegram.messenger.R$string")
Theme = jclass("org.telegram.ui.ActionBar.Theme")
Gravity = jclass("android.view.Gravity")
View = jclass("android.view.View")
FrameLayoutParams = jclass("android.widget.FrameLayout$LayoutParams")
WeakHashMap = jclass("java.util.WeakHashMap")
Collections = jclass("java.util.Collections")
REFRESH_S = 1.0   # a full rebuild at least this often while someone types

# Same order as the stock instanceof chain: (TL class, string key, type).
_ACTIONS = [
    ("TL_sendMessageRecordAudioAction", "IsRecordingAudio", 1),
    ("TL_sendMessageRecordRoundAction", "IsRecordingRound", 4),
    ("TL_sendMessageUploadRoundAction", "IsSendingVideo", 4),
    ("TL_sendMessageUploadAudioAction", "IsSendingAudio", 2),
    ("TL_sendMessageUploadVideoAction", "IsSendingVideo", 2),
    ("TL_sendMessageRecordVideoAction", "IsRecordingVideo", 2),
    ("TL_sendMessageUploadDocumentAction", "IsSendingFile", 2),
    ("TL_sendMessageUploadPhotoAction", "IsSendingPhoto", 2),
    ("TL_sendMessageGamePlayAction", "IsSendingGame", 3),
    ("TL_sendMessageGeoLocationAction", "IsSelectingLocation", 0),
    ("TL_sendMessageChooseContactAction", "IsSelectingContact", 0),
    ("TL_sendMessageEmojiInteractionSeen", "IsEnjoyngAnimations", 5),
    ("TL_sendMessageChooseStickerAction", "IsChoosingSticker", 5),
]


def _log(msg):
    try:
        jclass("android.util.Log").i(LOG_TAG, str(msg))
    except Exception:
        pass


def _res(key):
    return int(getattr(RString, key))


class TopicTypingPlugin(BasePlugin):

    def create_settings(self):
        return [
            Header(text="Topic Typing Indicator"),
            Switch(key="tabs_dots", text="Typing dots on topic tabs", default=True,
                   subtext="Shows animated dots on a topic tab while someone types in that topic."),
            Divider(text="The topic header and the topic list always show typing per topic."),
        ]

    def on_plugin_load(self):
        self.lock = threading.Lock()
        self.tabs = Collections.synchronizedMap(WeakHashMap())   # tab view -> "account:dialog:topic"
        self.dots = {}                                            # tab view hash -> dots view
        self.live = {}                                            # account -> {dialog: topics typing now}
        self.action_classes = []
        self.state = {}      # controller hash -> {"h": typing list hash, "t": last rebuild, "acc": account}
        self.applied = {}    # account -> signature of the texts last put on screen
        self.posted_live = {}  # account -> live set last sent to the UI thread
        try:
            self.neko = jclass("tw.nekomimi.nekogram.NekoConfig")
            self.ayu = jclass("tw.nekomimi.nekogram.filters.AyuFilter")
        except Exception:
            self.neko = None
            self.ayu = None
        try:
            self.emoji = jclass("org.telegram.messenger.Emoji")
        except Exception:
            self.emoji = None
        try:
            self.zalgo = jclass("tw.nekomimi.nekogram.helpers.MessageHelper")
        except Exception:
            self.zalgo = None
        self.nc_cls = jclass("org.telegram.messenger.NotificationCenter")
        self.print_mask = int(jclass("org.telegram.messenger.MessagesController").UPDATE_MASK_USER_PRINT)
        for name, key, typ in _ACTIONS:
            try:
                self.action_classes.append((jclass("org.telegram.tgnet.TLRPC$" + name), key, typ))
            except Exception as e:
                _log("no class %s: %s" % (name, e))

        mc_cls = find_class("org.telegram.messenger.MessagesController")
        plugin = self

        class PrintingHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    plugin._before_printing(param)
                except Exception as e:
                    _log("before printing: %s" % e)

            def after_hooked_method(self, param):
                try:
                    plugin._after_printing(param.thisObject)
                except Exception as e:
                    _log("after printing: %s" % e)

        self.hook_method(mc_cls.getDeclaredMethod("updatePrintingStrings"), PrintingHook())

        class TabSetHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    plugin._after_tab_set(param)
                except Exception as e:
                    _log("tab set: %s" % e)

        class TabClearHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    plugin.tabs.remove(param.thisObject)
                    plugin._show_dots(param.thisObject, False)
                except Exception as e:
                    _log("tab clear: %s" % e)

        for cname in ("org.telegram.ui.Components.TopicsTabsView$HorizontalTabView",
                      "org.telegram.ui.Components.TopicsTabsView$VerticalTabView"):
            cls = find_class(cname)
            if cls is None:
                _log("missing " + cname)
                continue
            for m in cls.getDeclaredMethods():
                n = m.getName()
                if n == "set" and len(m.getParameterTypes()) == 3:
                    self.hook_method(m, TabSetHook())
                elif n in ("setAll", "setAdd"):
                    self.hook_method(m, TabClearHook())
        self._hook_dots_phase()
        self.log("Topic Typing Indicator loaded")
        _log("loaded " + __version__)

    # ---- staggered typing dots everywhere ----------------------------------
    # Stock TypingDotsDrawable restarts each dot's cycle by dropping the time that ran
    # past 800 ms. Two dots that reset in the same frame stay identical forever, so after
    # a few minutes of typing the three dots pulse together (header, chat list, tabs).
    # Once a second every running dots drawable gets its stock 150 ms per dot offsets back.
    def _hook_dots_phase(self):
        plugin = self
        cls = find_class("org.telegram.ui.Components.TypingDotsDrawable")
        if cls is None:
            _log("missing TypingDotsDrawable")
            return
        self.dots_el = cls.getDeclaredField("elapsedTimes")
        self.dots_el.setAccessible(True)
        self.dots_st = cls.getDeclaredField("startTimes")
        self.dots_st.setAccessible(True)
        self.dots_all = Collections.synchronizedMap(WeakHashMap())
        self.dots_timer = False
        self.dots_paused = []

        from android_utils import R
        self.AppLoader = jclass("org.telegram.messenger.ApplicationLoader")
        self.dots_run = R(self._realign_dots)   # one Runnable for the whole run, reused

        class DotsHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    plugin.dots_all.put(param.thisObject, True)
                    if bool(plugin.AppLoader.mainInterfacePaused):
                        # started while XF is in the background: hold it until onResume
                        param.thisObject.stop()
                        if param.thisObject not in (plugin.dots_paused or []):
                            plugin.dots_paused.append(param.thisObject)
                        return
                    plugin._kick_dots(50)
                except Exception as e:
                    _log("dots hook: %s" % e)

        class ResumeHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    plugin._resume_dots()
                    if not plugin.dots_all.isEmpty():
                        plugin._kick_dots(50)
                except Exception as e:
                    _log("resume hook: %s" % e)

        class PauseHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    plugin._pause_dots()
                except Exception as e:
                    _log("pause hook: %s" % e)

        la = find_class("org.telegram.ui.LaunchActivity")
        if la is not None:
            try:
                self.hook_method(la.getDeclaredMethod("onResume"), ResumeHook())
                self.hook_method(la.getDeclaredMethod("onPause"), PauseHook())
            except Exception as e:
                _log("resume: %s" % e)

        for m in cls.getDeclaredMethods():
            if m.getName() == "start" and len(m.getParameterTypes()) == 0:
                self.hook_method(m, DotsHook())

    def on_plugin_unload(self):
        try:
            self.dots_timer = True    # nothing restarts it
            if getattr(self, "dots_run", None) is not None:
                AndroidUtilities.cancelRunOnUIThread(self.dots_run)
        except Exception as e:
            _log("unload: %s" % e)

    def _pause_dots(self):
        """XF went to the background: stop every running typing dots animation (they keep asking
        for frames at 30 fps even when nothing is on screen) and remember them for onResume."""
        self.dots_paused = []
        self.in_pause = True
        for d in list(self.dots_all.keySet().toArray())[:128]:
            if d is not None and d.isStarted():
                d.stop()
                self.dots_paused.append(d)

    def _resume_dots(self):
        self.in_pause = False
        for d in getattr(self, "dots_paused", None) or []:
            if d is not None and not d.isStarted():
                d.start()
        self.dots_paused = []

    def _kick_dots(self, delay):
        if not self.dots_timer and not bool(self.AppLoader.mainInterfacePaused):
            self.dots_timer = True
            AndroidUtilities.runOnUIThread(self.dots_run, int(delay))

    def _realign_dots(self):
        if bool(self.AppLoader.mainInterfacePaused):
            self.dots_timer = False    # background: stop; LaunchActivity.onResume starts it again
            return
        try:
            drs = list(self.dots_all.keySet().toArray())[:64]
            now = int(time.time() * 1000)
            running = 0
            for d in drs:
                if d is None or not d.isStarted():
                    continue
                cb = d.getCallback()
                if cb is not None and View.isInstance(cb) and not cb.isShown():
                    continue    # its view is off screen
                running += 1
                el = self.dots_el.get(d)
                st = self.dots_st.get(d)
                for a in range(3):
                    st[a] = 0.0
                    el[a] = float((now - 150 * a) % 800)
        except Exception as e:
            _log("realign dots: %s" % e)
            running = 0
        if running:
            AndroidUtilities.runOnUIThread(self.dots_run, 1000)
        else:
            self.dots_timer = False

    # ---- typing text -------------------------------------------------------

    def _name(self, user):
        try:
            for v in (user.first_name, user.last_name):
                if v is not None and len(str(v)) > 0:
                    return str(AndroidUtilities.removeDiacritics(v))
        except Exception:
            pass
        return ""

    def _filter(self, mc, arr):
        try:
            neko, ayu = self.neko, self.ayu
            if neko is None or not bool(neko.ignoreBlocked.Bool()):
                return arr
            blocked = get_private_field(mc, "blockePeers")
            out = []
            for pu in arr:
                uid = int(pu.userId)
                if blocked is not None and blocked.indexOfKey(uid) >= 0:
                    continue
                if bool(ayu.isCustomFilteredPeer(uid)):
                    continue
                out.append(pu)
            return out
        except Exception:
            return arr

    def _text(self, mc, arr):
        """Stock group wording for one topic's typing users. Returns (text, type) or None."""
        if len(arr) == 1:
            pu = arr[0]
            user = mc.getUser(JLong(int(pu.userId)))
            if user is None:
                return None
            name = self._name(user)
            action = pu.action
            for cls, key, typ in self.action_classes:
                if action is not None and isinstance(action, cls):
                    if key == "IsEnjoyngAnimations":
                        return LocaleController.formatString(key, _res(key), name, str(action.emoticon)), typ
                    return LocaleController.formatString(key, _res(key), name), typ
            return LocaleController.formatString("IsTypingGroup", _res("IsTypingGroup"), name), 0
        names = []
        for pu in arr:
            user = mc.getUser(JLong(int(pu.userId)))
            if user is not None:
                names.append(self._name(user))
            if len(names) == 2:
                break
        if not names:
            return None
        label = ", ".join(names)
        if len(names) == 1:
            return LocaleController.formatString("IsTypingGroup", _res("IsTypingGroup"), label), 0
        if len(arr) > 2:
            plural = LocaleController.getPluralString("AndMoreTypingGroup", len(arr) - 2)
            try:
                return JString.format(plural, label, JInteger(len(arr) - 2)), 0
            except Exception:
                return "LOC_ERR: AndMoreTypingGroup", 0
        return LocaleController.formatString("AreTypingGroup", _res("AreTypingGroup"), label), 0

    def _polish(self, text):
        try:
            paint = Theme.dialogs_messageNamePaint
            if paint is None:
                paint = jclass("android.graphics.Paint")()
                paint.setTypeface(AndroidUtilities.bold())
                paint.setTextSize(float(dp(14)))
            text = self.emoji.replaceEmoji(text, paint.getFontMetricsInt(), False)
        except Exception as e:
            _log("emoji: %s" % e)
        try:
            text = self.zalgo.zalgoFilter(text)
        except Exception as e:
            _log("zalgo: %s" % e)
        return text

    def _before_printing(self, param):
        """Skip the rebuild (stock's and ours) while the typing list has not changed."""
        mc = param.thisObject
        key = int(mc.hashCode())
        st = self.state.get(key)
        if st is None:
            st = {"h": None, "t": 0.0, "acc": int(get_private_field(mc, "currentAccount") or 0), "ran": False}
            self.state[key] = st
        st["ran"] = True
        try:
            h = int(mc.printingUsers.hashCode())
        except Exception:
            st["h"] = None   # list changing under us: let the rebuild run
            return
        now = time.monotonic()
        if h == st["h"] and now - st["t"] < REFRESH_S:
            st["ran"] = False
            param.setResult(None)
            return
        st["h"] = h
        st["t"] = now
        st["ran"] = True

    def _after_printing(self, mc):
        st = self.state.get(int(mc.hashCode()))
        if st is not None and not st["ran"]:
            return
        fixes = {}
        live = {}
        users = mc.printingUsers
        for did in list(users.keySet().toArray()):
            did = int(did)
            if did >= 0:
                continue
            threads = users.get(JLong(did))
            if threads is None:
                continue
            # which topics have someone typing right now; the tab dots read this, so
            # they never depend on the order the app swaps its typing texts in
            on = set()
            for tid in list(threads.keySet().toArray()):
                lst = threads.get(JInteger(int(tid)))  # the map is keyed by Integer
                if lst is not None and self._filter(mc, list(lst.toArray())):
                    on.add(int(tid))
            if on:
                live[did] = on
            if threads.size() < 2:
                continue  # one topic typing: stock text is already right
            per = {}
            for tid in list(threads.keySet().toArray()):
                tid = int(tid)
                lst = threads.get(JInteger(tid))
                if lst is None:
                    continue
                arr = self._filter(mc, list(lst.toArray()))
                if not arr:
                    continue
                res = self._text(mc, arr)
                if res is None:
                    continue
                per[tid] = (self._polish(res[0]), res[1])
            if per:
                # nothing fixable yet (names not loaded): leave stock's text alone
                fixes[did] = per
        account = st["acc"] if st is not None else int(get_private_field(mc, "currentAccount") or 0)
        live_changed = self.posted_live.get(account) != live
        if not fixes and not live_changed:
            return   # stock's texts are right and the tab dots are current: no UI work
        self.posted_live[account] = live
        sig = repr(sorted((d, sorted((t, str(x[0]), x[1]) for t, x in p.items())) for d, p in fixes.items()))

        def apply():
            self.live[account] = live
            try:
                strings = mc.printingStrings
                types = mc.printingStringsTypes
                for did, per in fixes.items():
                    s = LongSparseArray()
                    t = LongSparseArray()
                    for tid, (text, typ) in per.items():
                        s.put(tid, text)
                        t.put(tid, jint(typ))  # jint boxes to Integer; a plain int would become Long and crash getPrintingStringType
                    strings.put(did, s)
                    types.put(did, t)
                if fixes and self.applied.get(account) != sig:
                    self.applied[account] = sig
                    _log("topics typing: %s" % {d: sorted(p.keys()) for d, p in fixes.items()})
                    # redraw the open topic's header from the fixed texts; the app's own
                    # redraw can run before them and leave the header on one topic's text
                    nc = self.nc_cls
                    nc.getInstance(account).postNotificationName(nc.updateInterfaces, jarray(JObject)([JInteger(self.print_mask)]))
                elif not fixes:
                    self.applied.pop(account, None)
            except Exception as e:
                _log("apply: %s" % e)
            if live_changed:
                self._refresh_tabs(account)

        run_on_ui_thread(apply)

    # ---- topic tabs ----------------------------------------------------------

    def _after_tab_set(self, param):
        view = param.thisObject
        did = int(param.args[0])
        topic = param.args[1]
        account = int(get_private_field(view, "currentAccount") or 0)
        self.tabs.put(view, "%d:%d:%d" % (account, did, int(topic.id)))
        self._update_tab(view, recenter=True)

    def _typing_in(self, account, did, tid):
        on = self.live.get(account, {}).get(did, ())
        if tid in on:
            return True
        # General topic (id 1): typing there arrives without a topic id
        return tid == 1 and 0 in on

    def _update_tab(self, view, recenter=False):
        key = self.tabs.get(view)
        show = False
        if key is not None and bool(self.get_setting("tabs_dots", True)):
            account, did, tid = [int(x) for x in str(key).split(":")]
            show = self._typing_in(account, did, tid)
        self._show_dots(view, show, recenter)

    def _refresh_tabs(self, account):
        try:
            views = list(self.tabs.keySet().toArray())
        except Exception:
            return
        for v in views:
            try:
                if v.isAttachedToWindow():
                    self._update_tab(v)
            except Exception as e:
                _log("refresh tab: %s" % e)

    def _show_dots(self, view, show, recenter=False):
        key = int(view.hashCode())
        dots = self.dots.get(key)
        if dots is None:
            if not show:
                return
            drawable = jclass("org.telegram.ui.Components.TypingDotsDrawable")(True)
            drawable.setIsChat(False)
            drawable.setColor(Theme.getColor(Theme.key_chats_actionMessage))
            dots = View(view.getContext())
            dots.setBackground(drawable)
            horizontal = "Horizontal" in str(view.getClass().getName())
            if horizontal:
                # the tab lays its children out itself, so the dots sit at its top left
                # corner and _center_dots moves them over the middle of the title
                lp = FrameLayoutParams(dp(18), dp(13), Gravity.TOP | Gravity.LEFT)
            else:
                lp = FrameLayoutParams(dp(18), dp(13), Gravity.TOP | Gravity.RIGHT)
                lp.topMargin = dp(2)
                lp.rightMargin = dp(4)
            view.addView(dots, lp)
            self.dots[key] = dots
        if dots.getParent() is None or dots.getParent() != view:
            return
        drawable = dots.getBackground()
        if show:
            if dots.getVisibility() != View.VISIBLE or recenter:
                dots.setVisibility(View.VISIBLE)
                self._center_dots(view, dots)
                # once more after the next layout pass, when the title has its width
                run_on_ui_thread(lambda v=view, d=dots: self._center_dots(v, d), 60)
            if not drawable.isStarted():
                drawable.start()
        else:
            if dots.getVisibility() != View.GONE:
                dots.setVisibility(View.GONE)
            if drawable.isStarted():
                drawable.stop()

    def _center_dots(self, view, dots):
        """Horizontal tabs: put the dots over the middle of the topic title."""
        try:
            if "Horizontal" not in str(view.getClass().getName()):
                return
            tv = get_private_field(view, "textView")
            if tv is None or tv.getWidth() <= 0:
                return
            x = tv.getLeft() + (tv.getWidth() - dp(18)) / 2.0 - dots.getLeft()
            dots.setTranslationX(float(x))
        except Exception as e:
            _log("center dots: %s" % e)
